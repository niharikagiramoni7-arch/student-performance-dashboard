# Copy to .env for local use. Replace the Aiven placeholders with the values
# shown in Aiven Console > your MySQL service > Overview > Connection information.
MYSQL_HOST=mysql-209cb2df-niharikagiramoni7-dff2.a.aivencloud.com
MYSQL_PORT=19244
MYSQL_DATABASE=defaultdb
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your-aiven-password
MYSQL_SSL_MODE=REQUIRED

# Admin account and token signing secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-deploying
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional transactional email (configure one provider)
RESEND_API_KEY=your_resend_api_key
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME="Student Performance Dashboard"
